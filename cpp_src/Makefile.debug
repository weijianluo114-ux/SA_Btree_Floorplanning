# ===== Debug 版本 Makefile =====
# 使用方法: make -f Makefile
# 测试命令： gdb --args ./hw3_dbg ../testcase/n100.hardblocks ../testcase/n100.nets ../testcase/n100.pl ../output/n100_01.floorplan 0.1

# 编译器
GXX := g++

# Debug 专用编译选项
# -std=c++11   : 使用 C++11 标准
# -g           : 生成调试信息（供 gdb 等使用）
# -O0          : 关闭优化（调试时变量不会被优化掉）
# -Wall        : 开启几乎所有常规警告
# -Wextra      : 开启额外警告（推荐调试时使用）
# -DDEBUG      : 定义 DEBUG 宏，可在代码中用 #ifdef DEBUG 控制调试输出
CURVE_MODE ?= 0
DEBUG_COST_LOG ?= 0
SNAPSHOT_MODE ?= 0
GXXFLAGS := -std=c++11 -g -Og -Wall -Wextra -DDEBUG -DCURVE_MODE=$(CURVE_MODE) -DDEBUG_COST_LOG=$(DEBUG_COST_LOG) -DSNAPSHOT_MODE=$(SNAPSHOT_MODE)

# ---- spdlog（仅 DEBUG_COST_LOG=1 时参与编译/链接）----
ifeq ($(DEBUG_COST_LOG),1)
SPDLOG_INC := $(HOME)/local/include
SPDLOG_LIB := $(HOME)/local/lib
GXXFLAGS += -I$(SPDLOG_INC)
LDFLAGS := -L$(SPDLOG_LIB) -lspdlog -pthread
endif

GXXFLAGS += -MMD -MP

# 输出目录
BIN_DIR := ../bin

SRC := fixed-outline_floorplanning.cpp utils.cpp	# 源文件列表（多个源文件）
OBJ := $(addprefix $(BIN_DIR)/,$(SRC:.cpp=.o))	# 目标文件列表
EXE := $(BIN_DIR)/hw3_dbg	# 可执行文件

DEPS := $(OBJ:.o=.d)
# 显式指定默认目标：否则 -include 的 .d 文件第一条规则
# （../bin/fixed-outline_floorplanning.o）会抢走默认目标，
# 导致 make 只编译 .o、从不链接 hw3_dbg（运行的一直是旧可执行文件）。
.DEFAULT_GOAL := all
-include $(DEPS)

# 单一 stamp 文件，内容记录最近一次使用的 GXXFLAGS 与各模式宏。
# 任一内容变化（如改 -Og→-O3、切换 CURVE_MODE 等）都会让 stamp mtime 更新，
# 从而强制重编（因为 .o 依赖 stamp）。
BUILD_STAMP := $(BIN_DIR)/.build_mode

# 默认目标
.PHONY: all
all: $(BIN_DIR) $(EXE)

# 先确保 bin 目录存在
$(BIN_DIR):
	mkdir -p $@

# 链接
$(EXE): $(OBJ)
	$(GXX) $(GXXFLAGS) -o $@ $^ $(LDFLAGS)

# 内容式 stamp：模式变化才更新 mtime，否则保持旧 mtime 避免无谓重编
.PHONY: FORCE
FORCE:

$(BUILD_STAMP): FORCE | $(BIN_DIR)
	@printf '%s\n' 'GXXFLAGS=$(GXXFLAGS)' 'CURVE_MODE=$(CURVE_MODE)' 'DEBUG_COST_LOG=$(DEBUG_COST_LOG)' 'SNAPSHOT_MODE=$(SNAPSHOT_MODE)' > $@.tmp
	@if cmp -s $@ $@.tmp; then rm -f $@.tmp; else mv -f $@.tmp $@; fi

# 显式头文件依赖：确保改 algos_config.h 等头文件一定触发重编
CPP_HEADERS := algos_config.h utils.h json.hpp

$(BIN_DIR)/%.o: %.cpp $(CPP_HEADERS) $(BUILD_STAMP) | $(BIN_DIR)
	$(GXX) $(GXXFLAGS) -c -o $@ $<

# 清理
.PHONY: clean
clean:
	rm -rf $(BIN_DIR)/*.o $(BIN_DIR)/*.d $(EXE) $(BUILD_STAMP)
